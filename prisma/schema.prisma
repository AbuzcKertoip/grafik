// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           Int            @id @default(autoincrement())
  username     String         @unique
  password     String
  name         String?
  image        String?        // Base64 or URL
  role         String         @default("USER") // 'ADMIN', 'USER'
  hourlyRate   Float          @default(0.0)
  sortOrder    Int            @default(999)
  fixedShift   String?        // 'SHIFT_1', 'SHIFT_2' or null
  skipDuties   Boolean        @default(false)
  scheduleDays ScheduleDay[]
  workLogs     WorkLogEntry[]
  vacations    Vacation[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  
  // HR Fields
  vacationDaysLimit Int           @default(26) // 20 or 26 typically
  carriedOverVacationDays Int     @default(0)
  medicalExams      MedicalExam[]
  equipment         Equipment[]
  tools             Tool[]
  
  // Benefits
  hasInternetPackage Boolean @default(false)
  hasMultisportCard  Boolean @default(false)
  
  // Clothing Sizes
  shirtSize         String?       // XS, S, M, L, XL, XXL
  pantsSize         String?       // e.g. 32/32, L
  shoeSize          String?       // e.g. 42, 43
  jacketSize        String?       // M, L, XL
  cars              Car[]
  
  // Contact Info
  phone             String?
  email             String?       @unique
  emergencyContact  String?

  // New RBAC & Department fields
  departmentId      Int?
  department        Department?   @relation(fields: [departmentId], references: [id])
  secondaryDepartmentId Int?
  secondaryDepartment   Department? @relation("SecondaryDepartment", fields: [secondaryDepartmentId], references: [id])
  permissions       UserPermission[]

  // System Logs
  systemLogs        SystemLog[]
}

model Department {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  hasDuties   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  secondaryUsers User[] @relation("SecondaryDepartment")
}

model Permission {
  id          Int              @id @default(autoincrement())
  slug        String           @unique // e.g. 'manage_users', 'view_all_schedules'
  name        String           // Readable name
  description String?
  
  users       UserPermission[]
}

model UserPermission {
  userId       Int
  permissionId Int
  assignedAt   DateTime @default(now())
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([userId, permissionId])
}

model MedicalExam {
  id             Int      @id @default(autoincrement())
  userId         Int
  type           String // 'MEDICINE_WORK', 'SANITARY', 'SAFETY_TRAINING'
  validUntil     DateTime
  scanUrl        String?
  notifiedExpiry Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ScheduleDay {
  id     Int      @id @default(autoincrement())
  userId Int
  date   DateTime
  type   String // 'SHIFT_1', 'SHIFT_2', 'DUTY', 'VACATION', 'SICK', 'OFF'

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model WorkLogEntry {
  id          Int      @id @default(autoincrement())
  userId      Int
  date        DateTime
  startTime   String? // HH:mm
  endTime     String? // HH:mm
  description String
  project     String?
  duration    Float    @default(0.0)
  overtime    Float    @default(0.0)
  isNightWork Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Vacation {
  id        Int      @id @default(autoincrement())
  userId    Int
  startDate DateTime
  endDate   DateTime
  type         String   @default("VACATION") // 'VACATION', 'SICK', 'OTHER'
  status       String   @default("PENDING")  // 'PENDING', 'APPROVED', 'REJECTED'
  rejectReason String?
  createdAt    DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Equipment {
  id           Int      @id @default(autoincrement())
  userId       Int
  name         String   // e.g. "Laptop Dell Latitude", "iPhone 13"
  serialNumber String?  // e.g. "ABC123456"
  assignedDate DateTime @default(now())
  notes        String?
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Tool {
  id           Int      @id @default(autoincrement())
  userId       Int
  name         String   // e.g. "Wkrętarka Makita", "Zestaw kluczy"
  assignedDate DateTime @default(now())
  notes        String?
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Car {
  id                  Int       @id @default(autoincrement())
  make                String
  model               String
  plate               String    @unique
  vin                 String    @unique
  productionYear      Int
  inspectionValidUntil DateTime
  insuranceValidUntil  DateTime
  policyNumber        String
  status              String    @default("ACTIVE") // ACTIVE, SERVICE, INACTIVE

  caretakerId         Int?
  caretaker           User?     @relation(fields: [caretakerId], references: [id])

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

model SystemSettings {
  id              Int      @id @default(1)
  smtpHost        String?
  smtpPort        Int?
  smtpUser        String?
  smtpPassword    String?
  smtpFromEmail   String?
  smtpSecure      Boolean  @default(true) // SSL/TLS
  
  alertEmails     String?  // Odbiorcy alertów (oddzieleni przecinkami, domyślnie pusty = wszyscy admini?)
  alertDaysBefore Int      @default(30) // Z ilu dniowym wyprzedzeniem wysyłać powiadomienia
  lastAlertSent   DateTime? // Kiedy ostatnio sprawdzano i wysłano alerty (chroni przed spamowaniem)
  
  updatedAt       DateTime @updatedAt
}

model EmailLog {
  id        Int      @id @default(autoincrement())
  toEmail   String
  subject   String
  status    String   // 'SUCCESS', 'FAILED'
  errorMsg  String?
  sentAt    DateTime @default(now())
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model SystemLog {
  id          Int      @id @default(autoincrement())
  action      String
  description String
  userId      Int?
  errorCode   String?
  details     String?
  createdAt   DateTime @default(now())

  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

