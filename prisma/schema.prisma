generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                      Int                     @id @default(autoincrement())
  username                String                  @unique
  password                String
  name                    String?
  image                   String?
  role                    String                  @default("USER")
  hourlyRate              Float                   @default(0.0)
  sortOrder               Int                     @default(999)
  fixedShift              String?
  skipDuties              Boolean                 @default(false)
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  contractType            String                  @default("UOP")
  has10YearsSeniority     Boolean                 @default(false)
  hasChildren             Boolean                 @default(false)
  vacationDaysLimit       Float                   @default(26.0)
  carriedOverVacationDays Int                     @default(0)
  additionalVacationDays  Int                     @default(0)
  hasInternetPackage      Boolean                 @default(false)
  hasMultisportCard       Boolean                 @default(false)
  internetDescription     String?
  multisportDescription   String?
  shirtSize               String?
  pantsSize               String?
  shoeSize                String?
  jacketSize              String?
  phone                   String?
  email                   String?                 @unique
  emergencyContact        String?
  discordId               String?
  departmentId            Int?
  secondaryDepartmentId   Int?
  cars                    Car[]
  equipment               Equipment[]
  medicalExams            MedicalExam[]
  scheduleDays            ScheduleDay[]
  systemLogs              SystemLog[]
  tools                   Tool[]
  secondaryDepartment     Department?             @relation("SecondaryDepartment", fields: [secondaryDepartmentId], references: [id])
  department              Department?             @relation(fields: [departmentId], references: [id])
  permissions             UserPermission[]
  vacations               Vacation[]
  approvedReports         MonthlyVacationReport[] @relation("ApprovedReports")
  swapRequestsMade        ShiftSwapRequest[]      @relation("SwapRequester")
  swapRequestsReceived    ShiftSwapRequest[]      @relation("SwapTarget")
}

model Department {
  id             Int      @id @default(autoincrement())
  name           String   @unique
  description    String?
  hasDuties      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  secondaryUsers User[]   @relation("SecondaryDepartment")
  users          User[]
}

model Permission {
  id          Int              @id @default(autoincrement())
  slug        String           @unique
  name        String
  description String?
  users       UserPermission[]
}

model UserPermission {
  userId       Int
  permissionId Int
  assignedAt   DateTime   @default(now())
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, permissionId])
}

model MedicalExam {
  id             Int      @id @default(autoincrement())
  userId         Int
  type           String
  validUntil     DateTime
  scanUrl        String?
  notifiedExpiry Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ScheduleDay {
  id         Int       @id @default(autoincrement())
  userId     Int
  date       DateTime
  type       String
  vacationId Int?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  vacation   Vacation? @relation(fields: [vacationId], references: [id])

  @@unique([userId, date])
}

model Vacation {
  id           Int           @id @default(autoincrement())
  userId       Int
  startDate    DateTime
  endDate      DateTime
  type         String        @default("VACATION")
  status       String        @default("PENDING")
  rejectReason String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  note         String?
  scheduleDays ScheduleDay[]
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Equipment {
  id           Int      @id @default(autoincrement())
  userId       Int
  name         String
  serialNumber String?
  assignedDate DateTime @default(now())
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Tool {
  id           Int      @id @default(autoincrement())
  userId       Int
  name         String
  assignedDate DateTime @default(now())
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Car {
  id                   Int         @id @default(autoincrement())
  make                 String
  model                String
  plate                String      @unique
  vin                  String      @unique
  productionYear       Int
  inspectionValidUntil DateTime
  insuranceValidUntil  DateTime
  policyNumber         String
  acValidUntil         DateTime?
  acPolicyNumber       String?     @default("")
  ownershipType        String      @default("COMPANY")
  status               String      @default("ACTIVE")
  caretakerId          Int?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  acPolicyUrl          String?
  policyUrl            String?
  caretaker            User?       @relation(fields: [caretakerId], references: [id])
  repairs              CarRepair[]
}

model CarRepair {
  id          Int      @id @default(autoincrement())
  carId       Int
  date        DateTime
  cost        Float    @default(0.0)
  description String
  notes       String?
  invoiceUrl  String?
  createdAt   DateTime @default(now())
  car         Car      @relation(fields: [carId], references: [id], onDelete: Cascade)
}

model SystemSettings {
  id              Int       @id @default(autoincrement())
  smtpHost        String?
  smtpPort        Int?
  smtpUser        String?
  smtpPassword    String?
  smtpFromEmail   String?
  smtpSecure      Boolean   @default(true)
  alertEmails     String?
  alertDaysBefore Int       @default(30)
  discordWebhookUrl String?
  lastAlertSent   DateTime?
  updatedAt       DateTime  @updatedAt
}

model EmailLog {
  id       Int      @id @default(autoincrement())
  toEmail  String
  subject  String
  status   String
  errorMsg String?
  sentAt   DateTime @default(now())
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model SystemLog {
  id          Int      @id @default(autoincrement())
  action      String
  description String
  userId      Int?
  errorCode   String?
  details     String?
  createdAt   DateTime @default(now())
  user        User?    @relation(fields: [userId], references: [id])
}

model MonthlyVacationReport {
  id         Int       @id @default(autoincrement())
  year       Int
  month      Int
  status     String    @default("PENDING")
  approvedAt DateTime?
  approvedBy Int?
  approver   User?     @relation("ApprovedReports", fields: [approvedBy], references: [id])
  fileBase64 String?
  count      Int       @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([year, month])
}

model ShiftSwapRequest {
  id                 Int       @id @default(autoincrement())
  requesterId        Int
  targetUserId       Int
  requesterDate      DateTime
  targetUserDate     DateTime
  isWeekend          Boolean   @default(false)
  status             String    @default("PENDING_COLLEAGUE") // PENDING_COLLEAGUE, PENDING_MANAGER, APPROVED, REJECTED
  note               String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  requester          User      @relation("SwapRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  targetUser         User      @relation("SwapTarget", fields: [targetUserId], references: [id], onDelete: Cascade)
}
